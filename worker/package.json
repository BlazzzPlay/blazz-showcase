{
  "name": "portfolio-worker-foundation",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.18.0"
  },
  "scripts": {
    "build": "CF_SEND_TELEMETRY=false DO_NOT_TRACK=1 cloudflare build",
    "dev": "CF_SEND_TELEMETRY=false DO_NOT_TRACK=1 cloudflare dev",
    "test": "npm run test:api && npm run test:static && npm run test:foundation",
    "test:api": "node --test test/public-api.test.ts test/db.test.ts test/hardening.test.ts",
    "test:access": "node --test test/access-auth.test.ts",
    "test:static": "node --test test/static-integration.test.ts",
    "test:foundation": "CF_SEND_TELEMETRY=false DO_NOT_TRACK=1 STATIC_FIXTURE=1 cloudflare build && CF_SEND_TELEMETRY=false DO_NOT_TRACK=1 STATIC_FIXTURE=1 node --test test/foundation.test.ts",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "2.0.0-beta.sha-91c870c02",
    "@types/node": "26.6.5",
    "cf": "1.0.0-beta.14",
    "miniflare": "5.20261006.1-alpha",
    "typescript": "7.0.2",
    "vite": "8.3.4"
  },
  "dependencies": {
    "jose": "6.2.12"
  }
}
