---
const currentYear = new Date().getFullYear();
---

<footer class="footer">
  <div class="container footer-content glass">
    <div class="footer-bottom">
      <p>© {currentYear} Blazz Showcase • Fabian Mendoza. Todos los derechos reservados.</p>
      <!-- Owner-only entry; Cloudflare Access guards /private. nofollow keeps crawlers out. -->
      <a href="/private" class="panel-link" rel="nofollow" aria-label="Panel de contactos">
        <span aria-hidden="true">🔒</span> Panel
      </a>
    </div>
  </div>
</footer>

<style>
  .footer {
    padding-bottom: 3rem;
    margin-top: 5rem;
  }

  .footer-content {
    padding: 2rem 3rem;
    max-width: 900px;
    margin: 0 auto;
    text-align: center;
    border-radius: 999px;
  }

  .footer-bottom {
    font-size: 0.875rem;
    color: hsl(var(--text-muted) / 0.7);
    font-weight: 500;
  }

  .panel-link {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    margin-top: 0.75rem;
    padding: 0.4rem 0.9rem;
    border: 1px solid var(--glass-border);
    border-radius: 999px;
    color: hsl(var(--text-muted));
    font-size: 0.8rem;
    text-decoration: none;
    transition: color 0.2s, border-color 0.2s;
  }

  .panel-link:hover,
  .panel-link:focus-visible {
    color: hsl(var(--accent-light));
    border-color: hsl(var(--accent-light));
  }

  @media (prefers-reduced-motion: reduce) {
    .panel-link { transition: none; }
  }

  @media (max-width: 640px) {
    .footer-content {
      border-radius: 2rem;
    }
  }
</style>
