---
const stats = [
  { count: 10, prefix: '+', suffix: '', label: 'años desarrollando software' },
  { count: 3, prefix: '', suffix: '', label: 'proyectos educativos en producción' },
  { count: 24, prefix: '', suffix: ' h', label: 'tiempo máximo de respuesta' },
  { count: null, text: '100%', label: 'editable por tu equipo' },
];
---
<section id="inicio" class="hero" aria-labelledby="hero-title">
  <div class="hero-glow" aria-hidden="true"></div>
  <div class="container">
    <div class="hero-grid">
      <div class="hero-text">
        <div class="badge-wrapper glass">
          <span class="badge-dot" aria-hidden="true"></span>
          <span class="badge-text">Disponible para proyectos {new Date().getFullYear()}</span>
        </div>
        <h1 class="hero-title" id="hero-title">
          Tu colegio publica, gestiona y evalúa <span class="gradient-text gradient-primary">sin depender de nadie</span>.
        </h1>
        <p class="hero-description">
          Desarrollo sitios, plataformas y automatizaciones para educación en Chile. Lo hago desde adentro: soy Jefe de Informática de un colegio.
        </p>
        <div class="hero-actions">
          <a href="#contacto" class="btn btn-primary" data-track-cta="hero">Contar mi proyecto</a>
          <a href="#proyectos" class="btn btn-outline">Ver proyectos</a>
        </div>
      </div>
      <aside class="who" aria-label="Quién soy">
        <div class="who-head">
          <span class="who-avatar" aria-hidden="true">FM</span>
          <div><strong>Fabian Mendoza</strong><span class="who-role">Ingeniero en Informática (2015)</span></div>
        </div>
        <ul>
          <li>+10 años desarrollando software</li>
          <li>Jefe de Informática, Colegio Montessori</li>
          <li>Creador de EduCal Chile</li>
          <li>Respuesta en 24 horas hábiles</li>
        </ul>
      </aside>
    </div>
    <dl class="hero-stats" data-reveal-stagger>
      {stats.map((s) => (
        <div class="hero-stat">
          <dt class="sr-only">{s.label}</dt>
          <dd>
            {s.count === null
              ? <strong>{s.text}</strong>
              : <strong data-count={s.count} data-prefix={s.prefix} data-suffix={s.suffix}>{`${s.prefix}${s.count}${s.suffix}`}</strong>}
            <span aria-hidden="true">{s.label}</span>
          </dd>
        </div>
      ))}
    </dl>
  </div>
</section>

<script>
  const heroPrimaryCta = document.querySelector('[data-track-cta="hero"]');

  heroPrimaryCta?.addEventListener('click', () => {
    window.dispatchEvent(
      new CustomEvent('portfolio:funnel', {
        detail: { event: 'cta_click', source: 'hero' }
      })
    );
  });
</script>

<style>
  .hero {
    position: relative;
    padding-block: 6rem 3rem;
  }

  .hero-glow {
    position: absolute;
    top: 0;
    right: 5%;
    width: min(520px, 70vw);
    aspect-ratio: 1;
    border-radius: 50%;
    background: radial-gradient(circle, hsl(var(--primary-light) / 0.22), transparent 65%);
    filter: blur(20px);
    pointer-events: none;
    z-index: -1;
  }

  .hero-grid {
    display: grid;
    grid-template-columns: minmax(0, 1.25fr) minmax(0, 1fr);
    gap: 4rem;
    align-items: center;
  }

  .badge-wrapper {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.4rem 1rem;
    border-radius: 999px;
    max-width: 100%;
    animation: slideUpFade 0.8s ease-out both;
  }

  .badge-dot {
    flex: none;
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background-color: hsl(var(--accent-light));
    box-shadow: 0 0 0 4px hsl(var(--accent-light) / 0.2);
    animation: pulse 2s infinite;
  }

  .badge-text {
    font-size: 0.85rem;
    font-weight: 600;
    color: hsl(var(--text-muted));
  }

  .hero-title {
    font-size: clamp(2.1rem, 5.5vw, 4.25rem);
    font-weight: 800;
    line-height: 1.05;
    letter-spacing: -0.035em;
    margin: 1.25rem 0;
    animation: slideUpFade 0.8s 0.15s cubic-bezier(0.16, 1, 0.3, 1) both;
  }

  .gradient-text.gradient-primary {
    background: linear-gradient(135deg, hsl(var(--primary-light)) 30%, hsl(var(--accent)));
    -webkit-background-clip: text;
    background-clip: text;
    -webkit-text-fill-color: transparent;
  }

  .hero-description {
    font-size: clamp(1.05rem, 2.5vw, 1.2rem);
    color: hsl(var(--text-muted));
    max-width: 46ch;
    animation: slideUpFade 0.8s 0.3s cubic-bezier(0.16, 1, 0.3, 1) both;
  }

  .hero-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 1rem;
    margin-top: 2rem;
    animation: slideUpFade 0.8s 0.45s cubic-bezier(0.16, 1, 0.3, 1) both;
  }

  .hero-actions .btn {
    padding: 0.9rem 1.75rem;
    justify-content: center;
  }

  .who {
    display: grid;
    gap: 1.25rem;
    padding: 2rem;
    border-radius: 1.5rem;
    background: hsl(224 71% 4%);
    color: hsl(210 40% 98%);
    border: 1px solid hsla(224, 71%, 100%, 0.1);
    box-shadow: 0 30px 60px -30px hsl(var(--primary) / 0.45);
    animation: slideUpFade 0.8s 0.3s cubic-bezier(0.16, 1, 0.3, 1) both;
  }

  .who-head {
    display: flex;
    align-items: center;
    gap: 1rem;
  }

  .who-head strong,
  .who-role {
    display: block;
  }

  .who-role {
    color: hsl(215 20% 65%);
  }

  .who-avatar {
    flex: none;
    width: 64px;
    height: 64px;
    border-radius: 50%;
    display: grid;
    place-items: center;
    font-weight: 800;
    font-size: 1.4rem;
    color: white;
    background: linear-gradient(135deg, hsl(var(--primary)), hsl(var(--accent)));
  }

  .who ul {
    list-style: none;
    display: grid;
    gap: 0.6rem;
  }

  .who li {
    display: flex;
    gap: 0.6rem;
  }

  .who li::before {
    content: '✓';
    color: hsl(var(--accent-light));
    font-weight: 800;
  }

  .hero-stats {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 1rem;
    margin-top: 4rem;
    padding-top: 2rem;
    border-top: 1px solid var(--glass-border);
  }

  .hero-stat strong {
    display: block;
    font-family: var(--font-display);
    font-size: 2.25rem;
    font-weight: 800;
    letter-spacing: -0.02em;
  }

  .hero-stat span {
    display: block;
    font-size: 0.92rem;
    line-height: 1.4;
    color: hsl(var(--text-muted));
  }

  .sr-only {
    position: absolute;
    width: 1px;
    height: 1px;
    overflow: hidden;
    clip: rect(0, 0, 0, 0);
    white-space: nowrap;
  }

  @keyframes pulse {
    0%, 100% { transform: scale(1); opacity: 1; }
    50% { transform: scale(1.3); opacity: 0.6; }
  }

  @keyframes slideUpFade {
    from { transform: translateY(24px); opacity: 0; }
    to { transform: none; opacity: 1; }
  }

  @media (max-width: 900px) {
    .hero {
      padding-block: 2.5rem 1rem;
    }

    .hero-grid {
      grid-template-columns: minmax(0, 1fr);
      gap: 2rem;
    }

    .hero-actions {
      flex-direction: column;
    }

    .hero-actions .btn {
      padding: 1rem;
    }

    .who {
      padding: 1.5rem;
    }

    .hero-stats {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: 1.5rem 1rem;
      margin-top: 2.5rem;
    }

    .hero-stat strong {
      font-size: 1.75rem;
    }
  }
</style>
