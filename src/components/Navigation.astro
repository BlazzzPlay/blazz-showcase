---
const navItems = [
  { name: 'Qué hago', href: '/#que-hago' },
  { name: 'Proyectos', href: '/#proyectos' },
  { name: 'Cómo trabajo', href: '/#como' },
  { name: 'Preguntas', href: '/#faq' },
];
---

<nav class="nav" aria-label="Navegación principal">
  <div class="container nav-content glass">
    <div class="logo">
      <span class="logo-mark" aria-hidden="true">FM</span>
      <span class="logo-text">Fabian Mendoza</span>
    </div>
    <ul class="nav-links">
      {navItems.map(item => (
        <li><a href={item.href}>{item.name}</a></li>
      ))}
    </ul>
    <div class="nav-action">
      <a href="/#contacto" class="btn btn-primary d-none-mobile" data-track-cta="nav">Agendar conversación</a>
      <button class="icon-btn theme-toggle" type="button" aria-label="Cambiar a modo oscuro">
        <svg class="icon-moon" xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M21 12.8A9 9 0 1 1 11.2 3a7 7 0 0 0 9.8 9.8z"/></svg>
        <svg class="icon-sun" xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><circle cx="12" cy="12" r="4"/><path d="M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4"/></svg>
      </button>
      <button class="icon-btn mobile-menu-btn" aria-label="Abrir menú" aria-expanded="false" aria-controls="mobile-menu" aria-haspopup="true">
        <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="3" y1="12" x2="21" y2="12"></line><line x1="3" y1="6" x2="21" y2="6"></line><line x1="3" y1="18" x2="21" y2="18"></line></svg>
      </button>
    </div>
  </div>

  <div class="mobile-menu glass" id="mobile-menu" aria-hidden="true" hidden>
    <ul class="mobile-nav-links">
      {navItems.map(item => (
        <li><a href={item.href}>{item.name}</a></li>
      ))}
      <li><a href="/#contacto" class="gradient-text" data-track-cta="nav">Agendar conversación</a></li>
    </ul>
  </div>
</nav>

<script>
  // Dynamic Navbar on Scroll
  const nav = document.querySelector('.nav') as HTMLElement;
  const navContent = document.querySelector('.nav-content') as HTMLElement;
  
  if (nav && navContent) {
    window.addEventListener('scroll', () => {
      if (window.scrollY > 50) {
        navContent.classList.add('scrolled');
      } else {
        navContent.classList.remove('scrolled');
      }
    }, { passive: true });
  }

  // Theme toggle: persists the choice; the inline head script applies it before paint.
  const themeBtn = document.querySelector('.theme-toggle') as HTMLButtonElement | null;
  const root = document.documentElement;
  const syncThemeLabel = () => {
    themeBtn?.setAttribute('aria-label', root.dataset.theme === 'dark' ? 'Cambiar a modo claro' : 'Cambiar a modo oscuro');
  };
  syncThemeLabel();
  themeBtn?.addEventListener('click', () => {
    root.dataset.theme = root.dataset.theme === 'dark' ? 'light' : 'dark';
    try { localStorage.setItem('fm-theme', root.dataset.theme); } catch { /* storage may be blocked */ }
    syncThemeLabel();
  });

  // Highlight the nav link of the section in view.
  const sectionLinks = Array.from(document.querySelectorAll('.nav-links a')) as HTMLAnchorElement[];
  if ('IntersectionObserver' in window) {
    const sectionObserver = new IntersectionObserver((entries) => {
      entries.forEach((entry) => {
        if (!entry.isIntersecting) return;
        sectionLinks.forEach((a) => {
          if (a.hash === `#${entry.target.id}`) a.setAttribute('aria-current', 'true');
          else a.removeAttribute('aria-current');
        });
      });
    }, { rootMargin: '-45% 0px -50% 0px' });
    sectionLinks.forEach((a) => {
      const target = a.hash ? document.getElementById(a.hash.slice(1)) : null;
      if (target) sectionObserver.observe(target);
    });
  }

  // Mobile Menu Toggle
  const mobileMenuBtn = document.querySelector('.mobile-menu-btn') as HTMLButtonElement | null;
  const mobileMenu = document.querySelector('.mobile-menu') as HTMLElement | null;
  const mobileLinks = Array.from(document.querySelectorAll('.mobile-nav-links a')) as HTMLAnchorElement[];
  const navCtas = Array.from(document.querySelectorAll('[data-track-cta="nav"]')) as HTMLAnchorElement[];

  const emitNavCtaClick = () => {
    window.dispatchEvent(
      new CustomEvent('portfolio:funnel', {
        detail: { event: 'cta_click', source: 'nav' }
      })
    );
  };

  navCtas.forEach((cta) => cta.addEventListener('click', emitNavCtaClick));

  const setMobileLinksTabIndex = (isOpen: boolean) => {
    mobileLinks.forEach((link) => {
      link.tabIndex = isOpen ? 0 : -1;
    });
  };

  let focusedBeforeOpen: HTMLElement | null = null;

  const closeMenu = () => {
    if (!mobileMenu || !mobileMenuBtn) return;

    mobileMenu.classList.remove('active');
    mobileMenu.setAttribute('aria-hidden', 'true');
    mobileMenu.hidden = true;
    document.body.style.overflow = '';
    mobileMenuBtn.setAttribute('aria-expanded', 'false');
    mobileMenuBtn.setAttribute('aria-label', 'Abrir menú');
    setMobileLinksTabIndex(false);
    focusedBeforeOpen?.focus();
  };

  const openMenu = () => {
    if (!mobileMenu || !mobileMenuBtn) return;

    focusedBeforeOpen = document.activeElement as HTMLElement;
    mobileMenu.hidden = false;
    document.body.style.overflow = 'hidden';
    mobileMenu.classList.add('active');
    mobileMenu.setAttribute('aria-hidden', 'false');
    mobileMenuBtn.setAttribute('aria-expanded', 'true');
    mobileMenuBtn.setAttribute('aria-label', 'Cerrar menú');
    setMobileLinksTabIndex(true);
    mobileLinks[0]?.focus();
  };

  if (mobileMenuBtn && mobileMenu) {
    setMobileLinksTabIndex(false);

    mobileMenuBtn.addEventListener('click', () => {
      const isOpen = mobileMenu.classList.contains('active');
      if (isOpen) {
        closeMenu();
      } else {
        openMenu();
      }
    });

    mobileLinks.forEach(link => {
      link.addEventListener('click', () => {
        closeMenu();
      });
    });

    document.addEventListener('keydown', (event) => {
      if (!mobileMenu.classList.contains('active')) return;

      if (event.key === 'Escape') {
        event.preventDefault();
        closeMenu();
      }

      if (event.key === 'Tab' && mobileLinks.length > 0) {
        const first = mobileLinks[0];
        const last = mobileLinks[mobileLinks.length - 1];
        const active = document.activeElement;

        if (event.shiftKey && active === first) {
          event.preventDefault();
          last.focus();
        } else if (!event.shiftKey && active === last) {
          event.preventDefault();
          first.focus();
        }
      }
    });
  }
</script>

<style>
  .nav {
    position: sticky;
    top: 0;
    z-index: 100;
  }

  .nav-content {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 1rem;
    height: 68px;
    border-radius: 0;
    border-width: 0 0 1px;
    border-color: transparent;
    background: hsl(var(--background) / 0.85);
    max-width: none;
    padding-inline: max(1.5rem, calc((100% - 1200px) / 2 + 1.5rem));
    transition: border-color 0.3s ease, box-shadow 0.3s ease;
  }

  .nav-content.scrolled {
    border-color: var(--glass-border);
    box-shadow: 0 4px 30px hsl(224 71% 4% / 0.12);
  }

  .logo {
    display: flex;
    align-items: center;
    gap: 0.6rem;
    font-weight: 800;
  }

  .logo-mark {
    width: 32px;
    height: 32px;
    border-radius: 9px;
    display: grid;
    place-items: center;
    color: white;
    font-size: 0.8rem;
    background: linear-gradient(135deg, hsl(var(--primary)), hsl(var(--accent)));
  }

  .logo-text {
    font-family: var(--font-display);
    font-size: 1.15rem;
  }

  .nav-links {
    list-style: none;
    display: flex;
    gap: 1.75rem;
  }

  .nav-links a {
    position: relative;
    color: hsl(var(--text-muted));
    font-size: 0.95rem;
    font-weight: 500;
  }

  .nav-links a::after {
    content: '';
    position: absolute;
    left: 0;
    right: 0;
    bottom: -4px;
    height: 2px;
    background: hsl(var(--primary-light));
    transform: scaleX(0);
    transition: transform 0.25s ease;
  }

  .nav-links a:hover,
  .nav-links a[aria-current] {
    color: hsl(var(--text));
  }

  .nav-links a:hover::after,
  .nav-links a[aria-current]::after {
    transform: scaleX(1);
  }

  .nav-action {
    display: flex;
    align-items: center;
    gap: 0.6rem;
  }

  .nav-action .btn {
    padding: 0.6rem 1.25rem;
    font-size: 0.95rem;
  }

  .icon-btn {
    width: 44px;
    height: 44px;
    display: grid;
    place-items: center;
    border-radius: 0.75rem;
    border: 1px solid var(--glass-border);
    background: transparent;
    color: hsl(var(--text));
    cursor: pointer;
    transition: border-color 0.2s ease;
  }

  .icon-btn:hover {
    border-color: hsl(var(--primary-light));
  }

  :global([data-theme='light']) .icon-sun,
  :global([data-theme='dark']) .icon-moon {
    display: none;
  }

  .mobile-menu-btn {
    display: none;
  }

  .mobile-menu {
    display: none;
    position: fixed;
    top: 68px;
    left: 0;
    right: 0;
    bottom: 0;
    padding: 2rem 1.5rem;
    border-radius: 0;
    border-width: 1px 0 0;
    background: hsl(var(--background));
    opacity: 0;
    transform: translateY(-8px);
    pointer-events: none;
    transition: opacity 0.3s ease, transform 0.3s ease;
  }

  .mobile-menu.active {
    opacity: 1;
    transform: none;
    pointer-events: all;
  }

  .mobile-nav-links {
    list-style: none;
  }

  .mobile-nav-links a {
    display: block;
    font-family: var(--font-display);
    font-size: 1.6rem;
    font-weight: 800;
    padding: 0.85rem 0;
    border-bottom: 1px solid var(--glass-border);
  }

  @media (max-width: 900px) {
    .nav-links,
    .d-none-mobile {
      display: none;
    }

    .nav-content {
      height: 60px;
    }

    .mobile-menu {
      top: 60px;
    }

    .mobile-menu-btn,
    .mobile-menu {
      display: grid;
    }

    .mobile-menu {
      display: block;
    }

  }
</style>
