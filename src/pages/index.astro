---
import Layout from '../layouts/Layout.astro';
import { resolveSeoPage } from '../lib/seo/catalog';
import Navigation from '../components/Navigation.astro';
import Hero from '../components/Hero.astro';
import Projects from '../components/Projects.astro';
import Footer from '../components/Footer.astro';

const homeSeo = resolveSeoPage('/');

const needs = [
  {
    title: 'Un sitio que el colegio edite solo',
    body: 'Noticias, comunidad y docentes con un CMS simple. Sin pedirle cambios a un proveedor.',
    example: { label: 'Leonardo Da Vinci School', href: 'https://leonardodavincischool.cl/' },
    icon: '<rect x="3" y="4" width="18" height="16" rx="2"/><path d="M3 9h18M8 14h5"/>',
  },
  {
    title: 'Una plataforma para tu equipo',
    body: 'Producto SaaS a medida: gestión, evaluación y reportes, construido para escalar.',
    example: { label: 'EduCal Chile', href: 'https://educal-chile.vercel.app/' },
    icon: '<path d="M4 20V10M10 20V4M16 20v-7M22 20H2"/>',
  },
  {
    title: 'Menos trabajo manual',
    body: 'Formularios, paneles y flujos automatizados que eliminan planillas y errores repetitivos.',
    example: { label: 'panel de EDUCA', href: 'https://educavisiondefuturo.cl/' },
    icon: '<path d="M13 2 4 14h7l-1 8 9-12h-7z"/>',
  },
];

const steps = [
  { title: 'Conversación', body: 'Entiendo el problema y quién lo vive.' },
  { title: 'Propuesta', body: 'Alcance, arquitectura y plazos por escrito.' },
  { title: 'Construcción', body: 'Entregas cortas que podés probar.' },
  { title: 'Puesta en marcha', body: 'Producción, capacitación y soporte.' },
];

const faqs = [
  { q: '¿Mi equipo va a poder editar el sitio sin saber programar?', a: 'Sí. Uso un CMS visual y dejo una capacitación grabada para que noticias, docentes y documentos se actualicen sin pedir ayuda.' },
  { q: '¿Cuánto demora un sitio institucional?', a: 'Depende del alcance; en la propuesta escrita te entrego plazos por etapa antes de empezar.' },
  { q: '¿Quién queda como dueño del dominio y los datos?', a: 'El colegio. Dominio, cuentas y contenido quedan a nombre de la institución desde el primer día.' },
  { q: '¿Ofrecés soporte después del lanzamiento?', a: 'Sí, la puesta en marcha incluye un período de soporte y luego podés seguir con mantención mensual si lo necesitás.' },
];
---

<Layout seo={homeSeo}>
	<Navigation />
	<main>
		<Hero />
		
		<section id="que-hago" class="needs section-padding" data-animate="fade-up" aria-labelledby="needs-title">
			<div class="container">
				<div class="section-head">
					<p class="eyebrow">Qué hago</p>
					<h2 class="section-title" id="needs-title">Elegí lo que necesitás resolver</h2>
					<p class="section-lede">Tres formas concretas de ayudar a tu institución, con ejemplos reales que podés visitar hoy.</p>
				</div>
				<div class="needs-grid" data-reveal-stagger>
					{needs.map((n) => (
						<article class="need-card">
							<span class="need-icon" aria-hidden="true"><svg viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="currentColor" stroke-width="2" set:html={n.icon} /></span>
							<h3>{n.title}</h3>
							<p class="need-body">{n.body}</p>
							<p class="need-example">Ejemplo: <a href={n.example.href} target="_blank" rel="noopener noreferrer">{n.example.label} <span aria-hidden="true">↗</span><span class="sr-only">(abre en una nueva pestaña)</span></a></p>
						</article>
					))}
				</div>
			</div>
		</section>

		<Projects />

		<section id="como" class="process section-padding" data-animate="fade-up" aria-labelledby="process-title">
			<div class="container">
				<div class="section-head">
					<p class="eyebrow">Cómo trabajo</p>
					<h2 class="section-title" id="process-title">De la idea a producción, en etapas</h2>
				</div>
				<ol class="steps" data-reveal-stagger>
					{steps.map((step, i) => (
						<li class="step">
							<span class="step-num" aria-hidden="true">{String(i + 1).padStart(2, '0')}</span>
							<h3>{step.title}</h3>
							<p>{step.body}</p>
						</li>
					))}
				</ol>
			</div>
		</section>

		<section id="faq" class="faq section-padding" data-animate="fade-up" aria-labelledby="faq-title">
			<div class="container">
				<div class="section-head">
					<p class="eyebrow">Preguntas frecuentes</p>
					<h2 class="section-title" id="faq-title">Lo que suelen preguntar los colegios</h2>
				</div>
				<div class="faq-list" data-reveal-stagger>
					{faqs.map((f) => (
						<details class="faq-item">
							<summary>{f.q}</summary>
							<p>{f.a}</p>
						</details>
					))}
				</div>
			</div>
		</section>

		<section id="contacto" class="contact section-padding" data-animate="fade-up" aria-labelledby="contact-title">
			<div class="container">
				<div class="contact-content">
					<div class="contact-header">
						<p class="eyebrow">Contacto</p>
						<h2 class="section-title" id="contact-title">Contame qué querés <span class="gradient-text">construir</span></h2>
						<p class="contact-desc" id="contact-help">Completá el formulario y te respondo dentro de 24 horas hábiles.</p>
					</div>

					<form method="POST" id="contact-form" class="contact-form" aria-busy="false" novalidate>
						<div class="form-grid">
							<div class="form-group">
								<label for="name">Nombre</label>
								<input type="text" id="name" name="name" placeholder="Tu nombre" required minlength="2" maxlength="100" class="glass input-field" aria-describedby="contact-help name-hint" />
								<p id="name-hint" class="field-hint">Entre 2 y 100 caracteres.</p>
								<p id="name-error" class="field-error" hidden></p>
							</div>
							<div class="form-group">
								<label for="email">Email</label>
								<input type="email" id="email" name="email" placeholder="tu@email.com" required minlength="3" maxlength="254" class="glass input-field" aria-describedby="contact-help" />
								<p id="email-error" class="field-error" hidden></p>
							</div>
						</div>
						<div class="form-group">
							<label for="subject">Asunto</label>
							<input type="text" id="subject" name="subject" placeholder="¿En qué puedo ayudarte?" required minlength="3" maxlength="200" class="glass input-field" aria-describedby="contact-help subject-hint" />
							<p id="subject-hint" class="field-hint">Entre 3 y 200 caracteres.</p>
							<p id="subject-error" class="field-error" hidden></p>
						</div>
						<div class="form-group">
							<label for="message">Mensaje</label>
							<textarea id="message" name="message" rows="5" placeholder="Cuéntame más sobre tu idea..." required minlength="10" maxlength="4000" class="glass input-field" aria-describedby="contact-help message-hint"></textarea>
							<p id="message-hint" class="field-hint">Entre 10 y 4000 caracteres.</p>
							<p id="message-error" class="field-error" hidden></p>
						</div>

						<p id="contact-errors" class="sr-only" role="alert" aria-live="assertive"></p>
						<p id="contact-status" class="sr-only" role="status" aria-live="polite"></p>
						
						<div class="form-actions">
							<button type="submit" class="btn btn-primary btn-large w-full relative">
								<span class="btn-text">Registrar Solicitud</span>
								<span class="btn-spinner" aria-hidden="true">
									<svg class="animate-spin" xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 12a9 9 0 1 1-6.219-8.56"/></svg>
								</span>
							</button>
						</div>
						<p class="contact-alt">O escribime a <a href="mailto:blazzzplay@gmail.com">blazzzplay@gmail.com</a>.</p>
					</form>
				</div>
			</div>
		</section>
	</main>
	<a href="#contacto" class="btn btn-primary mobile-cta">Contar mi proyecto</a>
	<Footer />
</Layout>

<div id="toast-container" class="toast-container"></div>

<script>
	import { postJson } from '../lib/contact-api';

	// Mobile sticky CTA: visible after the hero, hidden once the contact section is on screen.
	const mobileCta = document.querySelector('.mobile-cta') as HTMLElement | null;
	const contactSection = document.getElementById('contacto');
	if (mobileCta && contactSection) {
		const onScroll = () => {
			const show = window.scrollY > window.innerHeight * 0.8 && contactSection.getBoundingClientRect().top > window.innerHeight;
			mobileCta.classList.toggle('show', show);
		};
		window.addEventListener('scroll', onScroll, { passive: true });
		onScroll();
	}

	const form = document.querySelector('#contact-form') as HTMLFormElement;
	const toastContainer = document.querySelector('#toast-container') as HTMLElement;
	const errorRegion = document.querySelector('#contact-errors') as HTMLElement;
	const statusRegion = document.querySelector('#contact-status') as HTMLElement;

	type FunnelEvent = 'cta_click' | 'form_start' | 'form_submit_success';
	type FunnelSource = 'hero' | 'nav' | 'contact_form';

	const getSessionId = () => {
		const existing = window.sessionStorage.getItem('portfolio_session_id');
		if (existing) return existing;

		const generated = `sess_${crypto.randomUUID()}`;
		window.sessionStorage.setItem('portfolio_session_id', generated);
		return generated;
	};

	async function track(event: FunnelEvent, source: FunnelSource) {
		try {
			await postJson('/api/funnel', {
				sessionId: getSessionId(),
				event,
				source,
			});
		} catch {
			// Best-effort tracking never blocks the primary flow.
		}
	}

	window.addEventListener('portfolio:funnel', (evt: Event) => {
		const custom = evt as CustomEvent<{ event: FunnelEvent; source: FunnelSource }>;
		if (!custom.detail) return;

		void track(custom.detail.event, custom.detail.source);
	});

	function showToast(message: string, type: 'success' | 'error') {
		const toast = document.createElement('div');
		toast.className = `toast toast-${type} glass`;
		toast.innerText = message;
		toastContainer.appendChild(toast);
		
		setTimeout(() => toast.classList.add('show'), 10);
		
		setTimeout(() => {
			toast.classList.remove('show');
			setTimeout(() => toast.remove(), 300);
		}, 5000);
	}

	const orderedFields = ['name', 'email', 'subject', 'message'] as const;
	function setFieldErrors(fields: Record<string, string[]> = {}) {
		for (const name of orderedFields) {
			const input = form.querySelector(`[name="${name}"]`) as HTMLInputElement | HTMLTextAreaElement;
			const region = document.getElementById(`${name}-error`)!;
			const message = fields[name]?.join(' ') ?? '';
			region.textContent = message;
			region.hidden = !message;
			input.setAttribute('aria-invalid', String(Boolean(message)));
			const hint = name === 'email' ? '' : ` ${name}-hint`;
			input.setAttribute('aria-describedby', `contact-help${hint}${message ? ` ${name}-error` : ''}`);
		}
		const first = orderedFields.find((name) => fields[name]?.length);
		if (first) (form.elements.namedItem(first) as HTMLElement).focus();
	}

	let hasTrackedFormStart = false;
	form?.addEventListener('focusin', () => {
		if (hasTrackedFormStart) return;
		hasTrackedFormStart = true;
		void track('form_start', 'contact_form');
	});

	let isSubmitting = false;
	form?.addEventListener('submit', async (e) => {
		e.preventDefault();
		if (isSubmitting) return;
		const submitBtn = form.querySelector('button[type="submit"]') as HTMLButtonElement;
		const btnText = submitBtn.querySelector('.btn-text') as HTMLElement;
		isSubmitting = true;
		submitBtn.disabled = true;
		form.setAttribute('aria-busy', 'true');
		btnText.textContent = 'Registrando solicitud…';
		statusRegion.textContent = 'Registrando solicitud…';
		errorRegion.textContent = '';

		try {
			const input = new FormData(form);
			const data = await postJson('/api/contact', {
				name: String(input.get('name') ?? ''), email: String(input.get('email') ?? ''),
				subject: String(input.get('subject') ?? ''), message: String(input.get('message') ?? ''),
			});
			setFieldErrors(data.success ? {} : data.fieldErrors);
			if (!data.success) {
				const message = data.message;
				errorRegion.textContent = message;
				statusRegion.textContent = '';
				showToast(message, 'error');
			} else {
				const message = data.message!;
				showToast(message, 'success');
				statusRegion.textContent = message;
				form.reset();
				hasTrackedFormStart = false;
				// Saving determines completion; analytics is best-effort and never awaited here.
				void track('form_submit_success', 'contact_form');
			}
		} catch {
			const message = 'Error crítico en el servidor.';
			errorRegion.textContent = message;
			statusRegion.textContent = '';
			showToast(message, 'error');
		} finally {
			form.setAttribute('aria-busy', 'false');
			btnText.textContent = 'Registrar Solicitud';
			submitBtn.disabled = false;
			isSubmitting = false;
		}
	});
</script>

<style>
	main {
		overflow-x: hidden;
	}

	.section-head {
		max-width: 60ch;
		margin-bottom: 2.5rem;
	}

	.section-head .section-title {
		margin-bottom: 1rem;
	}

	.section-lede {
		color: hsl(var(--text-muted));
		font-size: 1.1rem;
	}

	.section-padding {
		padding: 6rem 0;
	}

	.needs-grid {
		display: grid;
		grid-template-columns: repeat(3, minmax(0, 1fr));
		gap: 1.25rem;
	}

	.need-card {
		display: flex;
		flex-direction: column;
		padding: 1.75rem;
		border-radius: 1rem;
		background: var(--surface);
		border: 1px solid var(--glass-border);
		transition: transform 0.25s ease, border-color 0.25s ease, box-shadow 0.25s ease;
	}

	.need-card:hover {
		transform: translateY(-4px);
		border-color: hsl(var(--primary-light) / 0.5);
		box-shadow: 0 10px 40px -10px hsl(var(--primary) / 0.3);
	}

	.need-icon {
		width: 44px;
		height: 44px;
		display: grid;
		place-items: center;
		border-radius: 0.75rem;
		margin-bottom: 1rem;
		background: hsl(var(--primary) / 0.12);
		color: hsl(var(--primary-light));
	}

	.need-card h3 {
		font-size: 1.25rem;
		margin-bottom: 0.5rem;
	}

	.need-body {
		color: hsl(var(--text-muted));
		margin-bottom: 1rem;
		flex: 1;
	}

	.need-example {
		font-size: 0.9rem;
		padding-top: 0.9rem;
		border-top: 1px solid var(--glass-border);
		overflow-wrap: anywhere;
	}

	.need-example a {
		font-weight: 600;
		color: hsl(var(--primary-light));
	}

	.steps {
		list-style: none;
		display: grid;
		grid-template-columns: repeat(4, minmax(0, 1fr));
		gap: 1.5rem;
	}

	.step {
		padding-top: 1rem;
		border-top: 3px solid hsl(var(--primary-light));
	}

	.step-num {
		font-weight: 800;
		color: hsl(var(--primary-light));
	}

	.step h3 {
		font-size: 1.1rem;
		margin: 0.4rem 0;
	}

	.step p {
		color: hsl(var(--text-muted));
		font-size: 0.95rem;
	}

	.faq {
		padding-top: 2rem;
	}

	.faq-list {
		display: grid;
		gap: 0.75rem;
		max-width: 820px;
	}

	.faq-item {
		padding: 0 1.25rem;
		border-radius: 1rem;
		background: var(--surface);
		border: 1px solid var(--glass-border);
	}

	.faq-item summary {
		display: flex;
		justify-content: space-between;
		gap: 1rem;
		min-height: 44px;
		padding: 1.1rem 0;
		font-weight: 700;
		line-height: 1.4;
		cursor: pointer;
		list-style: none;
	}

	.faq-item summary::-webkit-details-marker {
		display: none;
	}

	.faq-item summary::after {
		content: '+';
		flex: none;
		font-size: 1.4rem;
		line-height: 1;
		color: hsl(var(--primary-light));
		transition: transform 0.25s ease;
	}

	.faq-item[open] summary::after {
		transform: rotate(45deg);
	}

	.faq-item p {
		color: hsl(var(--text-muted));
		padding-bottom: 1.2rem;
	}

	.contact-alt {
		color: hsl(var(--text-muted));
		margin-top: 1rem;
		overflow-wrap: anywhere;
	}

	.contact-alt a {
		color: hsl(var(--primary-light));
		font-weight: 600;
	}

	.mobile-cta {
		display: none;
	}

	.contact-content {
		min-width: 0;
		overflow-wrap: anywhere;
		display: grid;
		grid-template-columns: minmax(0, 1fr) minmax(0, 1.2fr);
		gap: 4rem;
		align-items: start;
	}

	.contact-desc {
		font-size: 1.125rem;
		color: hsl(var(--text-muted));
		max-width: 600px;
	}

	.contact-form {
		display: flex;
		flex-direction: column;
		gap: 1.5rem;
		padding: 2rem;
		border-radius: 2rem;
		background: var(--surface);
		border: 1px solid var(--glass-border);
	}

	.form-grid {
		display: grid;
		grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
		gap: 1.5rem;
	}

	.contact-form, .form-grid, .form-group, .form-actions {
		min-width: 0;
		width: 100%;
	}

	.form-group {
		display: flex;
		flex-direction: column;
		gap: 0.5rem;
	}

	.form-group label {
		font-size: 0.9rem;
		font-weight: 600;
		color: hsl(var(--text-muted));
	}

	.input-field {
		min-width: 0;
		width: 100%;
		max-width: 100%;
		font-size: 1rem;
		line-height: 1.5;
		padding: 0.75rem 1rem;
		color: hsl(var(--text));
		background: hsl(var(--background));
		outline: none;
		transition: border-color 0.2s;
		font-family: inherit;
	}

	.field-hint, .field-error {
		font-size: 0.875rem;
		line-height: 1.5;
		overflow-wrap: anywhere;
	}

	.field-hint { color: hsl(var(--text-muted)); }
	.field-error { color: hsl(0 90% 82%); }
	:global([data-theme='light']) .field-error { color: hsl(0 72% 40%); }
	:global([data-theme='light']) .input-field[aria-invalid="true"] { border-color: hsl(0 72% 40%); }
	.field-error[hidden] { display: none; }
	.input-field[aria-invalid="true"] { border-color: hsl(0 90% 82%); }
	.input-field::placeholder { color: hsl(var(--text-muted)); opacity: 1; }
	textarea.input-field { resize: vertical; }

	.input-field:focus-visible {
		outline: 3px solid hsl(var(--accent-light));
		outline-offset: 3px;
	}

	.input-field:focus {
		border-color: hsl(var(--primary-light));
		background: hsl(var(--background));
	}

	.sr-only {
		position: absolute;
		width: 1px;
		height: 1px;
		padding: 0;
		margin: -1px;
		overflow: hidden;
		clip: rect(0, 0, 0, 0);
		white-space: nowrap;
		border: 0;
	}

	.btn-large {
		padding: 1.25rem clamp(1rem, 4vw, 3rem);
		font-size: 1.1rem;
	}

	.relative {
		position: relative;
		display: flex;
		justify-content: center;
		align-items: center;
	}

	.w-full {
		width: 100%;
	}

	.btn-spinner { display: none; }
	.contact-form[aria-busy="true"] .btn-spinner { display: inline-flex; }
	.contact-form button { gap: 0.75rem; white-space: normal; }
	.contact-form button:disabled { cursor: wait; opacity: 0.8; transform: none; }
	.animate-spin { animation: spin 1s linear infinite; }

	@media (prefers-reduced-motion: reduce) {
		.contact-form[aria-busy="true"] .btn-spinner { display: none; }
	}

	@keyframes spin {
		from { transform: rotate(0deg); }
		to { transform: rotate(360deg); }
	}

	.toast-container {
		position: fixed;
		bottom: 2rem;
		right: 2rem;
		max-width: calc(100vw - 4rem);
		overflow-wrap: anywhere;
		display: flex;
		flex-direction: column;
		gap: 1rem;
		z-index: 1000;
	}

	.toast {
		padding: 1rem 1.5rem;
		border-radius: 0.75rem;
		font-size: 0.95rem;
		font-weight: 500;
		transform: translateX(120%);
		transition: transform 0.3s cubic-bezier(0.16, 1, 0.3, 1);
		box-shadow: 0 10px 30px -10px rgba(0,0,0,0.5);
	}

	.toast.show {
		transform: translateX(0);
	}

	.toast-success {
		border-left: 4px solid hsl(189, 74%, 43%);
	}

	.toast-error {
		border-left: 4px solid hsl(0, 84%, 60%);
	}

	@media (max-width: 900px) {
		.section-padding {
			padding: 4rem 0;
		}

		.needs-grid,
		.contact-content {
			grid-template-columns: minmax(0, 1fr);
			gap: 2rem;
		}

		.need-card {
			padding: 1.4rem;
		}

		/* Process becomes a vertical timeline. */
		.steps {
			grid-template-columns: minmax(0, 1fr);
			gap: 0;
		}

		.step {
			border-top: 0;
			border-left: 3px solid hsl(var(--primary-light));
			padding: 0 0 1.75rem 1rem;
		}

		.contact-form {
			padding: 1.4rem;
			border-radius: 1.5rem;
		}

		.form-grid {
			grid-template-columns: minmax(0, 1fr);
		}

		.mobile-cta {
			display: flex;
			justify-content: center;
			position: fixed;
			left: 1.25rem;
			right: 1.25rem;
			bottom: calc(1rem + env(safe-area-inset-bottom));
			z-index: 90;
			padding: 1rem;
			transform: translateY(160%);
			visibility: hidden;
