{
  "name": "cyan-chroma",
  "type": "module",
  "version": "1.0.0",
  "license": "MIT",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "node scripts/dev-stack.mjs",
    "build": "astro build",
    "preview": "astro preview --host",
    "astro": "astro",
    "typecheck": "tsc --noEmit",
    "quality:assert-lighthouse": "node scripts/assert-lighthouse.mjs",
    "seo:audit": "node --import tsx scripts/seo-audit.ts",
    "test:e2e": "playwright test",
    "test:e2e:headed": "playwright test --headed",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:report": "playwright show-report",
    "test:unit": "node --import tsx --test src/lib/seo/__tests__/*.test.ts"
  },
  "dependencies": {
    "@astrojs/sitemap": "^3.7.4",
    "astro": "^7.3.8"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.0",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3"
  }
}
